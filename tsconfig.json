{
  "compilerOptions": {
    "types": ["node"],
    "module": "nodenext",
    "moduleDetection": "force",
    "target": "ESNext",
    "sourceMap": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "paths": {
      "@tests/*": ["./playwright/*"],
      "@playwright.config": ["./playwright.config.ts"],
      "@testconfig": ["./testConfig.ts"]
    }
  }
}
